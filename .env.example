# Food SLM environment configuration (copy to .env and edit)
PROJECT_NAME="Food SLM - AI Recipe Assistant"

# REQUIRED in production: generate with  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database (defaults to SQLite file <project>/food_slm.db when unset)
# DATABASE_URL="postgresql://fooduser:CHANGE_ME@localhost:5432/foodslmdb"
POSTGRES_PASSWORD=change_me

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Opt-in unauthenticated demo user (local testing only)
ALLOW_DEMO_USER=false

# Paths default to locations inside the project; override only if needed
# PROJECT_ROOT=
# RECIPES_PARQUET_PATH=
# PROCESSED_PARQUET_PATH=
BASE_MODEL_NAME="Qwen/Qwen3-4B"
# FINAL_ADAPTER_DIR defaults to models/qwen3-4b-recipe-lora
# MODEL_OUTPUT_DIR=

# Model generation (set SLM_GENERATE=false to skip the neural model and use retrieval only)
SLM_GENERATE=true
SLM_MAX_NEW_TOKENS=450
